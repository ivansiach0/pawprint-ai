{
  "name": "pawprint-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "playwright test",
    "dev:api": "node --env-file-if-exists=.env.local --import tsx server/index.ts",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx server/seed.ts",
    "start:api": "node --import tsx server/index.ts"
  },
  "dependencies": {
    "@vanilla-extract/css": "^1.21.3",
    "better-auth": "^1.7.23",
    "drizzle-orm": "^0.45.4",
